<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Smart_Resume_Job_Search_App.UI.JobResultsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:Smart_Resume_Job_Search_App.Presentation"
    Title="Job Matches">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Back" Command="{Binding BackCommand}" />
    </ContentPage.ToolbarItems>

    <ContentPage.Content>
        <Grid Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Text="Recommended Jobs" FontSize="24" FontAttributes="Bold" Margin="0,0,0,8" />

            <CollectionView Grid.Row="1" ItemsSource="{Binding Jobs}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,4" Padding="12" HasShadow="True" CornerRadius="10">
                            <Grid ColumnDefinitions="Auto, *, Auto">

                                <BoxView Grid.Column="0" 
                                         Color="{Binding StatusColor}" 
                                         WidthRequest="12" 
                                         HeightRequest="12" 
                                         CornerRadius="6"
                                         VerticalOptions="Center" 
                                         Margin="0,0,12,0" />

                                <StackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="{Binding Job.Title}" FontAttributes="Bold" FontSize="Medium" />
                                    <Label Text="{Binding Job.Company}" FontSize="Small" />
                                    <Label Text="{Binding Job.Location}" FontSize="Small" />
                                    <Label FontSize="Small">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Salary: " FontAttributes="Bold" />
                                                <Span Text="{Binding Job.SalaryMin, StringFormat='{}{0:C0}'}" />
                                                <Span Text=" - " />
                                                <Span Text="{Binding Job.SalaryMax, StringFormat='{}{0:C0}'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </StackLayout>

                                <StackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">

                                    <ActivityIndicator
                                        IsRunning="{Binding IsBusy}" 
                                        IsVisible="{Binding IsBusy}" 
                                        WidthRequest="20" 
                                        HeightRequest="20" 
                                        HorizontalOptions="Center"/>

                                    <Button Text="Tailor Resume" 
                                            FontSize="10"
                                            HeightRequest="36"
                                            BackgroundColor="{StaticResource Primary}"
                                            Command="{Binding TailorCommand}"
                                            IsVisible="{Binding ShowTailorButton}" />

                                    <Button Text="View Tailored" 
                                            FontSize="10"
                                            HeightRequest="36"
                                            BackgroundColor="{StaticResource Secondary}"
                                            Command="{Binding ViewTailoredCommand}"
                                            IsVisible="{Binding ShowViewButton}" />

                                    <Button Text="Job Posting ↗"
                                            FontSize="10"
                                            HeightRequest="36"
                                            BackgroundColor="Gray"
                                            Command="{Binding OpenJobCommand}" />
                                </StackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </ContentPage.Content>
</ContentPage>