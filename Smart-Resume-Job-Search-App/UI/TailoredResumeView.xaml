<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Smart_Resume_Job_Search_App.UI.TailoredResumeView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Smart_Resume_Job_Search_App.Presentation"
    x:DataType="vm:TailoredResumeViewModel"
    Title="Tailored Resume">

	<ContentPage.ToolbarItems>
		<ToolbarItem Text="Back" Command="{Binding BackCommand}" />
	</ContentPage.ToolbarItems>
	
	<Grid RowDefinitions="Auto,*">
		<HorizontalStackLayout
            Grid.Row="0"
            Padding="16,8"
            HorizontalOptions="Fill"
            VerticalOptions="Center">
			<Label
                Text="Tailored Resume"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="StartAndExpand" />
		</HorizontalStackLayout>

		<ScrollView Grid.Row="1">
			<VerticalStackLayout Padding="16" Spacing="12">
				<Label Text="{Binding JobTitle}"
                       FontSize="20"
                       FontAttributes="Bold" />

				<Label Text="{Binding Company}"
                       FontAttributes="Italic" />

				<Border Stroke="Gray"
                        StrokeThickness="1"
                        Padding="12"
                        Margin="0,8,0,8">
					<Label Text="{Binding ResumeText}"
                           LineBreakMode="WordWrap" />
				</Border>

				<Button Text="Download"
                        Command="{Binding DownloadCommand}"
                        HorizontalOptions="End" />
			</VerticalStackLayout>
		</ScrollView>
	</Grid>
</ContentPage>
